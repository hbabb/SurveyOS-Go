// ============================================================
// Staff, access, and audit
// ============================================================

Enum employee_position {
  office_admin
  researcher
  cad
  field
  pls
}

Table employees {
  id bigint [pk, increment]
  auth_provider_user_id varchar(255) [null, unique, note: 'User ID from the hosted auth service. Never used as a foreign key target.']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email email_address [not null, unique]
  position employee_position [not null, note: 'Descriptive only — permissions come from employee_roles.']
  initials varchar(3) [not null]
  is_active boolean [not null, default: true, note: 'Deactivating an employee also revokes their api_tokens.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    position
    is_active
  }
}

Table employee_licenses {
  id bigint [pk, increment]
  employee_id bigint [not null]
  state varchar(2) [not null]
  license_number varchar(40) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (employee_id, state) [unique]
  }

  note: 'State licenses, self-managed by PLS-position employees on their own profile.'
}

Table roles {
  id bigint [pk, increment]
  name varchar(155) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table permissions {
  id bigint [pk, increment]
  name varchar(255) [not null, unique]
  description text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table role_permissions {
  role_id bigint [not null]
  permission_id bigint [not null]

  indexes {
    (role_id, permission_id) [pk]
  }
}

Table employee_roles {
  employee_id bigint [not null]
  role_id bigint [not null]

  indexes {
    (employee_id, role_id) [pk]
  }

  note: 'An employee can hold more than one role.'
}

Table api_tokens {
  id bigint [pk, increment]
  employee_id bigint [not null]
  name varchar(120) [not null, note: 'Label, e.g. the workstation the token is used on.']
  token_hash varchar(255) [not null, unique, note: 'Hashed token. The plain token is shown once at creation and never stored.']
  last_used_at timestamptz [null]
  expires_at timestamptz [null, note: 'Expiry policy depends on the CAD authentication option.']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    employee_id
  }

  note: 'Per-employee tokens for the Civil 3D endpoints.'
}

Table activity_log {
  id bigint [pk, increment]
  subject_type varchar(100) [null, note: 'Table name of the changed record.']
  subject_id bigint [null]
  causer_employee_id bigint [null, note: 'NULL = system action.']
  event varchar(40) [null, note: 'created / updated / deleted, etc.']
  description text [not null]
  changes jsonb [null, note: 'Old and new values of changed fields.']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (subject_type, subject_id)
    causer_employee_id
  }

  note: 'Audit history for any table. No one-off history tables.'
}

Table number_sequences {
  sequence_type varchar(20) [not null, note: 'proposal or project']
  year int [not null]
  next_number int [not null, default: 1]

  indexes {
    (sequence_type, year) [pk]
  }

  note: 'Generates P-YYNNNN (proposal, at creation) and YYNNNN (project, at acceptance).'
}

// ============================================================
// Clients
// ============================================================

Enum account_status {
  active
  inactive
  prospect
  suspended
}

Table companies {
  id bigint [pk, increment]
  name varchar(220) [not null]
  account_status account_status [not null, default: 'active']
  main_email email_address [null, unique]
  main_phone phone_number [null, unique]
  accounting_email email_address [null, unique]

  billing_address_line_1 varchar(255) [not null]
  billing_address_line_2 varchar(255) [null]
  billing_city varchar(120) [not null]
  billing_state varchar(2) [not null, note: 'USPS state abbreviation. US-only by design.']
  billing_zip varchar(10) [not null]

  physical_address_line_1 varchar(255) [null]
  physical_address_line_2 varchar(255) [null]
  physical_city varchar(120) [null]
  physical_state varchar(2) [null]
  physical_zip varchar(10) [null]

  billing_notes text [null]
  notes text [null]
  restrict_contacts_to_assigned_projects boolean [not null, default: false]
  external_customer_id varchar(64) [null, note: 'Customer ID in the accounting system.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    name
    account_status
  }
}

Enum contact_role {
  project_manager
  accounting
  title_agent
  realtor
  attorney
  lender
  property_owner
}

Table contacts {
  id bigint [pk, increment]
  company_id bigint [null, note: 'NULL = individual client.']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email email_address [not null, unique]
  phone phone_number [not null]
  title varchar(160) [null]
  contact_role contact_role [null]
  account_status account_status [null, note: 'Only used when company_id IS NULL. Company contacts inherit companies.account_status. Leads = prospect.']
  portal_enabled boolean [not null, default: false, note: 'Client portal is post-V1.']
  notification_email email_address [null, note: 'NULL = use contacts.email.']
  can_view_accounting boolean [not null, default: false]
  can_view_all_company_projects boolean [not null, default: false]

  address_line_1 varchar(255) [null]
  address_line_2 varchar(255) [null]
  city varchar(120) [null]
  state varchar(2) [null]
  zip varchar(10) [null]

  notes text [null]
  external_customer_id varchar(64) [null, note: 'Customer ID in the accounting system (individual clients).']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    company_id
  }
}

// ============================================================
// Intake and proposals
// ============================================================

Table site_intakes {
  id bigint [pk, increment]
  contact_id bigint [not null]
  address_line_1 varchar(255) [null]
  address_line_2 varchar(255) [null]
  city varchar(120) [not null]
  county varchar(120) [not null]
  state varchar(2) [not null]
  zip varchar(10) [null]
  township varchar(120) [null]
  pin varchar(60) [null, note: 'Required when there is no address.']
  notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    contact_id
    city
    county
    township
    pin
  }

  checks {
    `address_line_1 IS NOT NULL OR pin IS NOT NULL`
  }
}

Table service_types {
  id bigint [pk, increment]
  name varchar(140) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (`lower(name)`) [unique, name: 'idx_service_types_name_lower']
  }

  note: 'Survey services offered. Names are unique regardless of capitalization.'
}

Enum proposal_status {
  draft
  sent
  viewed
  accepted
  declined
  expired
}

Enum proposal_accepted_via {
  portal
  employee_entry
}

Table proposals {
  id bigint [pk, increment]
  proposal_no varchar(8) [not null, unique, note: 'P-YYNNNN, generated at creation.']
  site_intake_id bigint [not null]
  change_order_project_id bigint [null, note: 'Set when this proposal is a change order on an existing project.']
  service_type_id bigint [not null]
  scope_description text [not null]
  exclusions_description text [null]
  fee_amount_cents bigint [null, note: 'Whole cents. Required once the proposal leaves draft.']
  status proposal_status [not null, default: 'draft']
  sent_at timestamptz [null]
  viewed_at timestamptz [null]
  accepted_at timestamptz [null]
  accepted_via proposal_accepted_via [null]
  accepted_by_employee_id bigint [null, note: 'Staff member who logged an emailed acceptance.']
  accepted_note text [null]
  accepted_ip_address inet [null]
  declined_at timestamptz [null]
  declined_reason text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    site_intake_id
    service_type_id
    change_order_project_id
    status
    accepted_ip_address
  }

  checks {
    `proposal_no ~ '^P-[0-9]{6}$'`
    `status <> 'accepted' OR accepted_at IS NOT NULL`
    `status = 'draft' OR fee_amount_cents IS NOT NULL`
    `fee_amount_cents >= 0`
  }
}

// ============================================================
// Projects
// ============================================================

Enum project_status {
  research
  ready_for_schedule
  scheduled
  ready_for_drafting
  ready_for_review
  ready_for_invoice
  awaiting_payment
  ready_to_deliver
  delivered
}

Enum project_priority {
  high
  urgent
}

Enum project_customer_status {
  project_started
  project_delayed
  draft_ready
  final_ready
}

Table projects {
  id bigint [pk, increment]
  project_no varchar(6) [not null, unique, note: 'YYNNNN, generated at proposal acceptance.']
  project_name varchar(220) [not null]
  proposal_id bigint [not null, unique, note: 'Original proposal. One project per proposal.']
  status project_status [not null, default: 'research', note: 'Two-way — no enforced forward-only transitions.']
  status_changed_at timestamptz [null]
  priority project_priority [null, note: 'Off by default. Overrides the computed research/CAD queue order.']
  field_scheduled_date date [null]
  invoiced_at timestamptz [null]
  last_followed_up_at timestamptz [null]
  customer_status project_customer_status [not null, default: 'project_started']
  customer_status_notes text [null]
  target_delivery date [null]
  project_manager_id bigint [null]
  researcher_id bigint [null]
  is_active boolean [not null, default: true]
  archived_at timestamptz [null, note: 'Set = archived and locked. Only a superuser can unarchive.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    status
    (status, last_followed_up_at)
  }

  checks {
    `project_no ~ '^[0-9]{6}$'`
  }
}

Table project_field_crew {
  project_id bigint [not null]
  employee_id bigint [not null]

  indexes {
    (project_id, employee_id) [pk]
    employee_id
  }
}

Enum project_horizontal_datum {
  "NAD27"
  "NAD83 (NSRS 2011)"
  "WGS84"
}

Enum project_vertical_datum {
  "NGVD29"
  "NAVD88 (GEOID18)"
}

Enum project_drawing_scale {
  "1\" = 1'"
  "1\" = 5'"
  "1\" = 10'"
  "1\" = 20'"
  "1\" = 30'"
  "1\" = 40'"
  "1\" = 50'"
  "1\" = 60'"
  "1\" = 70'"
  "1\" = 80'"
  "1\" = 100'"
  "1\" = 200'"
  "1\" = 300'"
  "1\" = 400'"
}

Table project_survey_details {
  id bigint [pk, increment]
  project_id bigint [not null, unique]
  drawing_title varchar(220) [null]
  ordered_by_name varchar(190) [null]
  zoning_district varchar(60) [null]
  setback_front_ft decimal(6,2) [null]
  setback_side_ft decimal(6,2) [null]
  setback_rear_ft decimal(6,2) [null]
  setback_notes text [null]
  ngs_monument_name varchar(80) [null]
  ngs_combined_scale_factor decimal(10,8) [null]
  horizontal_datum project_horizontal_datum [not null, default: 'NAD83 (NSRS 2011)']
  vertical_datum project_vertical_datum [not null, default: 'NAVD88 (GEOID18)']
  basis_of_bearing text [null]
  benchmark_description varchar(190) [null]
  certifying_surveyor_id bigint [null]
  field_date date [null]
  survey_date date [null]
  draft_date date [null]
  checked_date date [null]
  drafter_id bigint [null]
  checker_id bigint [null]
  revision varchar(20) [null]
  sheet_no int [null]
  total_sheets int [null]
  drawing_scale project_drawing_scale [null]
  drafted_in_field boolean [not null, default: false, note: 'True when the field crew chief started the drawing on site. CAD does a QA and labeling pass instead of a full draft.']
  recording_requested boolean [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    certifying_surveyor_id
    drafter_id
    checker_id
  }

  note: 'Title block and survey data, one row per project.'
}

Enum location_source {
  geocoded
  manual
}

Table project_cad_setups {
  id bigint [pk, increment]
  project_id bigint [not null, unique]
  latitude decimal(10,7) [null, note: 'WGS84. No elevation stored.']
  longitude decimal(10,7) [null, note: 'WGS84.']
  location_source location_source [null, note: 'manual always wins and is never overwritten by geocoding.']
  geocoded_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  note: 'Geocoding is button-triggered on the CAD setup screen. Rooftop matches only.'
}

Table project_fema_references {
  id bigint [pk, increment]
  project_id bigint [not null]
  sort_order int [not null, default: 0]
  fema_map_number varchar(40) [not null]
  fema_effective_date date [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    project_id
    fema_map_number
  }
}

Table project_invoice_followups {
  id bigint [pk, increment]
  project_id bigint [not null]
  employee_id bigint [not null]
  note text [null]
  followed_up_at timestamptz [not null]

  indexes {
    project_id
  }
}

// ============================================================
// Subdivisions
// ============================================================

Table project_lots {
  id bigint [pk, increment]
  project_id bigint [not null]
  lot_number varchar(40) [not null]
  house_plan varchar(120) [null]
  homeowner_name varchar(220) [null, note: 'Title block only. Homeowners are not contacts.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    project_id
  }
}

Enum lot_deliverable_type {
  lot_fit
  plot_plan
  house_stake
  pin_footings
  final_mortgage_survey
}

Table project_lot_deliverables {
  id bigint [pk, increment]
  project_lot_id bigint [not null]
  type lot_deliverable_type [not null]
  date_ordered date [null]
  date_completed date [null, note: 'Not null = complete.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (project_lot_id, type) [unique]
  }
}

// ============================================================
// Research
// ============================================================

Table project_parcels {
  id bigint [pk, increment]
  project_id bigint [not null]
  sort_order int [not null, default: 0]
  parcel_label varchar(60) [null]
  subject_pin varchar(80) [null]
  current_owner_name varchar(220) [null]
  subdivision_name varchar(190) [null]
  lot_number varchar(40) [null]
  site_area_acres decimal(10,4) [null]
  deed_book varchar(20) [null]
  deed_page varchar(20) [null]
  plat_book varchar(20) [null]
  plat_page varchar(20) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    project_id
    subject_pin
    (deed_book, deed_page)
    (plat_book, plat_page)
  }

  note: 'Subject parcels. A project can have more than one.'
}

Table parcel_transfers {
  id bigint [pk, increment]
  project_parcel_id bigint [not null]
  grantor varchar(220) [not null]
  grantee varchar(220) [not null]
  deed_book varchar(20) [not null]
  deed_page varchar(20) [not null]
  plat_book varchar(20) [null, note: 'Optional — ownership transfers by deed only.']
  plat_page varchar(20) [null]
  recorded_date date [not null]
  instrument_type varchar(60) [null]
  project_document_id bigint [null]
  notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (project_parcel_id, recorded_date)
  }

  note: 'Ownership chain. One row per transfer.'
}

Table project_adjoiners {
  id bigint [pk, increment]
  project_parcel_id bigint [not null]
  owner_name varchar(220) [null]
  pin varchar(80) [null]
  deed_book varchar(20) [null]
  deed_page varchar(20) [null]
  plat_book varchar(20) [null]
  plat_page varchar(20) [null]
  subdivision_name varchar(190) [null]
  lot_number varchar(40) [null]
  zoning varchar(60) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    project_parcel_id
  }
}

Table project_research_notes {
  id bigint [pk, increment]
  project_id bigint [not null]
  employee_id bigint [not null]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    project_id
  }
}

Enum document_type {
  research
  final_deliverable
}

Table project_documents {
  id bigint [pk, increment]
  project_id bigint [not null]
  type document_type [not null]
  path varchar(500) [not null, note: 'Object key in the S3-compatible bucket.']
  original_filename varchar(255) [not null]
  mime_type varchar(120) [null]
  size_bytes bigint [null]
  uploaded_by_employee_id bigint [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, type)
  }
}

// ============================================================
// Invoicing
// ============================================================

Table project_invoices {
  id bigint [pk, increment]
  project_id bigint [not null]
  invoice_no varchar(40) [not null, unique]
  amount_cents bigint [not null, note: 'Total of the line items, in whole cents.']
  paid_at date [null, note: 'Staff-marked payment.']
  external_invoice_id varchar(64) [null, unique, note: 'Invoice ID in the accounting system.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    project_id
  }

  note: 'SurveyOS owns invoice records. The accounting system receives a copy.'
}

Table project_invoice_line_items {
  id bigint [pk, increment]
  project_invoice_id bigint [not null]
  sort_order int [not null, default: 0]
  description text [not null]
  quantity decimal(10,2) [not null, default: 1]
  unit_price_cents bigint [not null]
  amount_cents bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    project_invoice_id
  }
}

// ============================================================
// Relationships
// ============================================================

Ref: employee_licenses.employee_id > employees.id [delete: cascade]
Ref: role_permissions.role_id > roles.id [delete: cascade]
Ref: role_permissions.permission_id > permissions.id [delete: cascade]
Ref: employee_roles.employee_id > employees.id [delete: cascade]
Ref: employee_roles.role_id > roles.id [delete: cascade]
Ref: api_tokens.employee_id > employees.id [delete: cascade]
Ref: activity_log.causer_employee_id >? employees.id [delete: set null]

Ref: contacts.company_id >? companies.id [delete: set null]

Ref: site_intakes.contact_id > contacts.id [delete: restrict]
Ref: proposals.site_intake_id > site_intakes.id [delete: restrict]
Ref: proposals.service_type_id > service_types.id [delete: restrict]
Ref: proposals.change_order_project_id >? projects.id [delete: restrict]
Ref: proposals.accepted_by_employee_id >? employees.id [delete: set null]

Ref: projects.proposal_id - proposals.id [delete: restrict]
Ref: projects.project_manager_id >? employees.id [delete: set null]
Ref: projects.researcher_id >? employees.id [delete: set null]
Ref: project_field_crew.project_id > projects.id [delete: cascade]
Ref: project_field_crew.employee_id > employees.id [delete: cascade]

Ref: project_survey_details.project_id - projects.id [delete: cascade]
Ref: project_survey_details.certifying_surveyor_id >? employees.id [delete: set null]
Ref: project_survey_details.drafter_id >? employees.id [delete: set null]
Ref: project_survey_details.checker_id >? employees.id [delete: set null]
Ref: project_cad_setups.project_id - projects.id [delete: cascade]
Ref: project_fema_references.project_id > projects.id [delete: cascade]
Ref: project_invoice_followups.project_id > projects.id [delete: cascade]
Ref: project_invoice_followups.employee_id > employees.id [delete: cascade]

Ref: project_lots.project_id > projects.id [delete: cascade]
Ref: project_lot_deliverables.project_lot_id > project_lots.id [delete: cascade]

Ref: project_parcels.project_id > projects.id [delete: cascade]
Ref: parcel_transfers.project_parcel_id > project_parcels.id [delete: cascade]
Ref: parcel_transfers.project_document_id >? project_documents.id [delete: set null]
Ref: project_adjoiners.project_parcel_id > project_parcels.id [delete: cascade]
Ref: project_research_notes.project_id > projects.id [delete: cascade]
Ref: project_research_notes.employee_id > employees.id [delete: restrict]
Ref: project_documents.project_id > projects.id [delete: restrict]
Ref: project_documents.uploaded_by_employee_id >? employees.id [delete: set null]

Ref: project_invoices.project_id > projects.id [delete: restrict]
Ref: project_invoice_line_items.project_invoice_id > project_invoices.id [delete: cascade]
